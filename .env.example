PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# ── Database MySQL/MariaDB (XAMPP: user root, password kosong) ──
# Dipakai server (src/lib/prisma.ts) DAN Prisma CLI (prisma.config.ts menyusun URL dari sini).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dinoyo_admin
# Jumlah koneksi siap pakai di dalam pool.
DB_CONNECTION_LIMIT=10

# Opsional: isi bila ingin memberi Prisma CLI URL lengkap (menimpa DB_* di atas untuk migrate/studio).
# DATABASE_URL=mysql://root@localhost:3306/dinoyo_admin

# Nama cookie sesi yang dikirim API (HttpOnly, SameSite=Strict, Max-Age).
SESSION_COOKIE=kd_api_session

# ── Keamanan, rate limit & logging ──
# Di production CLIENT_ORIGIN WAJIB diisi (origin frontend, pisahkan dengan koma bila lebih dari satu).
# trust proxy Express: "loopback" (default), angka jumlah hop proxy (mis. 1), atau daftar IP/subnet proxy.
# TRUST_PROXY=loopback
# Batas umum seluruh /api per IP (endpoint login/daftar/unggah punya batas sendiri yang lebih ketat).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ── Cloud Storage: Vercel Blob (foto sampul toko) ──
# Vercel Dashboard → Storage → Create → Blob → buka store → tab ".env.local" → salin BLOB_READ_WRITE_TOKEN.
# Kosong = endpoint unggah menjawab 503. JANGAN taruh token ini di frontend.
BLOB_PUBLIC_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=
# Ukuran maksimal foto (byte). Default 2 MB.
UPLOAD_MAX_FOTO_BYTES=2097152



